<%- | String $node_ip,
      String $private_key,
      Integer $listen_port,
      Array[Hash[String, Any]] $peers
| -%>
# Capstan WireGuard Overlay Configuration
# Generated by Puppet capstan_network::wireguard

[Interface]
Address = <%= $node_ip %>
PrivateKey = <%= $private_key %>
ListenPort = <%= $listen_port %>
SaveConfig = false

<% $peers.each |$peer| { -%>
[Peer]
# Peer: <%= $peer['name'] %>
PublicKey = <%= $peer['public_key'] %>
AllowedIPs = <%= $peer['allowed_ips'].join(', ') %>
<% if $peer['endpoint'] { -%>
Endpoint = <%= $peer['endpoint'] %>
<% } -%>
PersistentKeepalive = <%= pick($peer['keepalive'], 25) %>

<% } -%>
