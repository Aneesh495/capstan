<%- | Integer $sample_interval_ms,
      Float $drift_threshold_percent
| -%>
# Capstan High-Frequency Kernel Probes Configuration
# Generated by Puppet capstan_telemetry::probes

[probes]
sample_interval_ms = <%= $sample_interval_ms %>
drift_threshold_percent = <%= $drift_threshold_percent %>
ring_buffer_pages = 64
perf_event_buffer_kb = 512

[tracepoints]
sched_switch = true
sys_enter_bpf = true
net_dev_xmit = true
tcp_probe = true
block_rq_issue = true

[ring_buffer]
shm_path = /dev/shm/capstan_telemetry_ring.shm
slot_count = 16384
slot_size_bytes = 128
