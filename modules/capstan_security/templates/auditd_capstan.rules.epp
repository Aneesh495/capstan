<%- | -%>
# Capstan Immutable Linux Auditd Rules
# Generated by Puppet capstan_security::auditd

# Monitor changes to Capstan configuration and key directories
-w /etc/capstan -p wa -k capstan_config_change
-w /etc/wireguard -p wa -k capstan_wireguard_change
-w /opt/capstan/bin -p wa -k capstan_bin_change

# Monitor bpf and ptrace system calls
-a always,exit -F arch=b64 -S bpf -k capstan_bpf_call
-a always,exit -F arch=b64 -S ptrace -k capstan_ptrace_call

# Make audit rules immutable until reboot
-e 2
