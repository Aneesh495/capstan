<%- | String $node_id,
      String $cluster_name,
      String $role,
      Integer $convergence_seconds,
      String $log_level,
      String $socket_path,
      Integer $api_port,
      String $data_dir,
      String $journal_dir,
      String $staging_dir,
      String $ledger_dir
| -%>
# Capstan Autonomous Daemon Configuration
# Generated by Puppet capstan_core::service

[node]
id = <%= $node_id %>
cluster = <%= $cluster_name %>
role = <%= $role %>

[engine]
convergence_interval_sec = <%= $convergence_seconds %>
log_level = <%= $log_level %>
socket_path = <%= $socket_path %>
api_port = <%= $api_port %>
max_workers = 4

[storage]
data_dir = <%= $data_dir %>
journal_dir = <%= $journal_dir %>
staging_dir = <%= $staging_dir %>
ledger_dir = <%= $ledger_dir %>

[telemetry]
enable_ebpf = true
sample_frequency_hz = 100
drift_threshold_percent = 5.0
