<%- | Integer $ingress_port,
      Integer $backend_port
| -%>
global
  log /dev/log local0
  maxconn 32768
  user haproxy
  group haproxy
  daemon

defaults
  log global
  mode http
  option httplog
  option dontlognull
  timeout connect 5000ms
  timeout client 50000ms
  timeout server 50000ms

frontend edge_ingress
  bind *:<%= $ingress_port %>
  mode http
  default_backend edge_backend

backend edge_backend
  mode http
  balance roundrobin
  option httpchk GET /health
  server worker1 127.0.0.1:<%= $backend_port %> check
