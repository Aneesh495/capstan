#!/usr/bin/env python3
"""
Capstan Autonomous State Convergence Daemon CLI Entrypoint.
"""

import os
import sys
import argparse
import asyncio

# Ensure parent directory is in sys.path
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..")))

from capstand.config import CapstanConfig
from capstand.logging import setup_logging

def parse_args():
    parser = argparse.ArgumentParser(description="Capstan Autonomous State Convergence Daemon")
    parser.add_argument("--config", "-c", default="/etc/capstan/capstand.conf", help="Path to daemon config file")
    parser.add_argument("--interval", "-i", type=int, help="Convergence loop interval seconds")
    parser.add_argument("--log-level", "-l", default="info", choices=["debug", "info", "warn", "error"], help="Logging verbosity")
    parser.add_argument("--dry-run", action="store_true", help="Execute catalog compilation without applying mutations")
    return parser.parse_args()

async def run_daemon(args):
    config = CapstanConfig.from_file(args.config)
    if args.interval:
        config.convergence_interval_sec = args.interval
    if args.log_level:
        config.log_level = args.log_level

    logger = setup_logging(config.log_level)
    logger.info(f"Starting Capstan autonomous daemon (Node: {config.node_id}, Cluster: {config.cluster_name})")
    logger.info(f"Convergence cycle configured for {config.convergence_interval_sec} seconds")

    # In standalone stub mode or tests, exit cleanly
    if args.dry_run:
        logger.info("Dry-run requested; initialization verified cleanly.")
        return 0

    logger.info("Capstan daemon initialized successfully.")
    return 0

def main():
    args = parse_args()
    return asyncio.run(run_daemon(args))

if __name__ == "__main__":
    sys.exit(main())
